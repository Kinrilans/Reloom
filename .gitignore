!.env.example
*.pem
*.key

# Зависимости и сборка
node_modules/
.next/
dist/
build/
coverage/

# Клиент Prisma — сборочный артефакт, пересоздаётся `pnpm db:generate`.
# В git ему делать нечего: он привязан к платформе и к версии схемы,
# и в ревью от него один шум.
src/generated/

