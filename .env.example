# Шаблон переменных окружения. Скопировать в .env и заполнить:
#
#   cp .env.example .env
#
# .env в git не попадает никогда (.gitignore). Ключ, попавший в git,
# считается скомпрометированным: его отзывают и выпускают новый
# (docs/security.md).
#
# Здесь — только имена и безопасные значения по умолчанию. Настоящих
# ключей в этом файле нет и быть не должно.

# --- База ---------------------------------------------------------------
# Порт должен совпадать с docker-compose.yml. 5434, а не 5432, нарочно:
# 5432 почти всегда занят локально установленным Postgres, а 5433 —
# вторым таким же. Соединение при этом не падает, а уходит в чужую базу,
# и разбираешься потом с ошибкой авторизации, а не с тем, что порт чужой.
#
# Если 5434 тоже занят: поменять POSTGRES_PORT и ровно на столько же
# поправить порт здесь.
DATABASE_URL="postgresql://reloom:reloom@localhost:5434/reloom?schema=public"
# POSTGRES_PORT=5434

# Отдельная база для тестов. Тесты начинают каждый случай с полной
# очистки таблиц, поэтому рабочую базу им давать нельзя: один `pnpm
# test` стирает всё, включая оператора админки. Имя базы обязано
# отличаться от рабочей; создаёт её `pnpm db:test-prepare`, который
# запускается сам перед тестами.
TEST_DATABASE_URL="postgresql://reloom:reloom@localhost:5434/reloom_test?schema=public"

# --- Эмитент карт (Oxen) ------------------------------------------------
# mock — локальная заглушка, с неё начинается разработка.
# Дальше sandbox и production (docs/oxen-integration.md).
OXEN_MODE="mock"
OXEN_BASE_URL="https://api.sbx.oxen.finance/v1/card"
OXEN_API_KEY=""
# Публичный RSA-ключ для реквизитов карты. Расшифровка идёт на устройстве
# пользователя, на сервер открытые данные не попадают (docs/security.md).
OXEN_RSA_PUBLIC_KEY=""
# Секрет для проверки подписи вебхуков. Неподписанный вебхук не
# обрабатывается.
OXEN_WEBHOOK_SECRET=""

# --- Крипто-адреса и возвраты -------------------------------------------
# new.cryptocurrencyapi.net: выдача адресов, события о поступлениях,
# отправка возвратов (docs/crypto-integration.md).
#
# ЭТОТ КЛЮЧ ОПАСНЕЕ ОСТАЛЬНЫХ: им отправляют деньги. Хранить и
# ротировать отдельно, в интерфейс не выводить ни в каком виде.
WALLET_MODE="mock"
WALLET_BASE_URL="https://new.cryptocurrencyapi.net"
WALLET_API_KEY=""
WALLET_WEBHOOK_SECRET=""

# --- Проверка происхождения средств -------------------------------------
# getblock.net. Оценку риска мы не считаем — она приходит готовой, мы
# только сравниваем её с порогом из настроек админки.
AML_MODE="mock"
AML_BASE_URL="https://getblock.net"
AML_API_KEY=""

# --- Telegram -----------------------------------------------------------
# Токен от @BotFather. Им же проверяется подпись initData в Mini App.
TELEGRAM_BOT_TOKEN=""

# --- Админка ------------------------------------------------------------
# Переменных для админки нет: сессии операторов хранятся в базе и
# отзываются вместе с оператором, а подписывать их нечем — отдельного
# секрета сессий у нас нет. Первый оператор заводится командой
#   pnpm db:seed-admin admin@example.com

# --- Разное -------------------------------------------------------------
# Язык продукта по умолчанию (docs/i18n.md).
DEFAULT_LOCALE="en"
# Базовый адрес приложения: в ссылки из писем и бота подставляется он.
APP_BASE_URL="http://localhost:3000"
