import { fileURLToPath } from 'node:url'
import { defineConfig } from 'vitest/config'

/**
 * Тесты гоняются в node-окружении: всё важное в этом проекте — деньги,
 * леджер, адаптеры внешних сервисов — живёт на сервере, и ставить ради
 * него браузерную эмуляцию незачем.
 *
 * **Тестам нужна поднятая база.** На этапе 0 было наоборот, и причина
 * была верной: тест, которому нужен докер, краснеет на машине без
 * докера и перестаёт что-либо значить. На этапе 1 она перестала
 * работать: ядро системы — леджер, а он весь про транзакции базы,
 * уникальные индексы и гонки двух операторов. Проверить это на
 * заглушке в памяти нельзя — точнее, можно, но такая проверка
 * подтвердит только то, что заглушка работает как заглушка.
 *
 * Поэтому перед `pnpm test` нужен `docker compose up -d`. Так же, как
 * перед `pnpm dev` (SETUP.md).
 */
export default defineConfig({
  resolve: {
    alias: {
      // Тот же `@/…`, что в tsconfig: пути в тестах и в коде должны
      // писаться одинаково.
      '@': fileURLToPath(new URL('./src', import.meta.url)),
    },
  },
  test: {
    environment: 'node',
    include: ['tests/**/*.test.ts'],
    setupFiles: ['tests/setup.ts'],
    // База одна на все файлы, и каждый тест чистит её перед собой.
    // Параллельные файлы вычищали бы данные друг у друга, и падения
    // были бы плавающими — худший вид падений.
    fileParallelism: false,
  },
})
